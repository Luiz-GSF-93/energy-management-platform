# Default: process alive, all PEE business routes disabled.
PEE_CORE_ENABLED=false
# Separate Core-access homologation mode. Keep the reference gateway disabled.
PEE_ACCESS_ENABLED=false
PEE_PUBLIC_ORIGIN=https://SUBDOMINIO-PEE-CONFIGURADO
CORE_PUBLIC_ORIGIN=https://PORTAL-CORE-CONFIGURADO
CORE_OWNER_ORGANIZATION_ID=
CORE_WORKSPACE_TENANT_ID=
# Dedicated random 32-byte base64url secrets. Never commit real values.
# CORE_PEER_SECRET matches ENERGY_CORE_PEE_PEER_SECRET in the Core worker.
CORE_PEER_SECRET=
# Independent encryption key; MUST differ from the peer secret.
PEE_COOKIE_KEY=
# Persistent project workspace. Use only the dedicated PEE Supabase project.
PEE_PROJECTS_ENABLED=false
SUPABASE_URL=https://SEU-PROJETO-PEE.supabase.co
SUPABASE_SERVER_KEY=CONFIGURAR_CHAVE_SECRET_SOMENTE_NO_SERVIDOR
# Legacy service_role JWT remains optional for compatibility:
# SUPABASE_SERVICE_ROLE_KEY=CONFIGURAR_SOMENTE_NO_SERVIDOR
# Fields below apply only to the older reference licensing gateway.
CORE_ISSUER=https://AUTORIDADE-DE-IDENTIDADE-DO-CORE
CORE_AUDIENCE=energyos-pee-licensing
CORE_PUBLIC_KEY_FILE=/run/secrets/core-public.pem
CORE_WEBHOOK_SECRET=CONFIGURAR_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES
CORE_SIGNATURE_API_URL=https://API-REAL-DO-CORE/ASSINATURA
CORE_SIGNATURE_API_TOKEN=CONFIGURAR_SOMENTE_NO_SERVIDOR
PORT=3001

# Enable only after the matching Core activity connector release has passed regression.
PEE_ACTIVITY_ENABLED=false

# Enable only after the Core directory connector and schema 003 are deployed.
PEE_AUTHOR_DIRECTORY_ENABLED=false
# Shared existing Resend account; never reuse another application key.
# Receiving requires a dedicated full-access key; only registered PEE reply routes are fetched.
# Apply schema 004 and 005 before enabling.
PEE_RESEND_ENABLED=false
PEE_RESEND_API_KEY=
PEE_RESEND_WEBHOOK_SECRET=
PEE_MAIL_FROM=projetos@pee-mail.energy-os.app.br
PEE_MAIL_RECEIVING_DOMAIN=pee-mail.energy-os.app.br

# External licensing: requires dedicated database schemas 006–008 and matching private Core release.
PEE_LICENSING_ENABLED=false
# Optional, bounded EVA generation through the existing Core Azure provider; never changes project data.
PEE_EVA_AI_ENABLED=false
# Enable only after the custom domain certificate and matching Core origin are verified.
PEE_CANONICAL_REDIRECT_ENABLED=false

# Requires dedicated PEE schema 009–012 plus reviewed Core 105/106. Keep off during rollout.
PEE_CLIENT_PORTAL_ENABLED=false
PEE_CONTENT_PROTECTION_ENABLED=false
PEE_BILLING_ENABLED=false
PEE_SALES_AUTOMATION_ENABLED=false
