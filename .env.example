# API
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_TIMEOUT=30000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54323
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Vercel (produção)
NEXT_PUBLIC_VERCEL_URL=https://yourdomain.com

# Analytics
NEXT_PUBLIC_SENTRY_DSN=

# Environment
NEXT_PUBLIC_ENV=development

# Backend only: existing-member organization notifications
RESEND_API_KEY=
MEMBERSHIP_EMAIL_FROM=Expert Energy <nao-responda@notificacoes.expertenergy.com.br>

# Preparação privada de assinatura Clicksign; chamadas externas não implementadas nesta fase.
SALES_SIGNATURE_PREPARATION_ENABLED=false

# Clicksign draft creation: all capabilities delivered OFF; sandbox token only in backend secret storage.
SALES_SIGNATURE_COMMANDS_ENABLED=false
SALES_SIGNATURE_CALLS_ENABLED=false
SALES_CLICKSIGN_BASE_URL=https://sandbox.clicksign.com/api/v3
SALES_CLICKSIGN_SANDBOX_TOKEN=
