# API
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_TIMEOUT=30000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54323
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Vercel (produção)
NEXT_PUBLIC_VERCEL_URL=https://yourdomain.com

# Analytics
NEXT_PUBLIC_SENTRY_DSN=

# Environment
NEXT_PUBLIC_ENV=development

# Backend only: existing-member organization notifications
RESEND_API_KEY=
MEMBERSHIP_EMAIL_FROM=Expert Energy <nao-responda@notificacoes.expertenergy.com.br>

# Preparação privada de assinatura Clicksign; chamadas externas não implementadas nesta fase.
SALES_SIGNATURE_PREPARATION_ENABLED=false

# Clicksign draft creation: all capabilities delivered OFF; sandbox token only in backend secret storage.
SALES_SIGNATURE_COMMANDS_ENABLED=false
SALES_SIGNATURE_CALLS_ENABLED=false
SALES_CLICKSIGN_BASE_URL=https://sandbox.clicksign.com/api/v3
SALES_CLICKSIGN_SANDBOX_TOKEN=

# Independent read-only recovery, delivered OFF.
SALES_SIGNATURE_RECOVERY_ENABLED=false
SALES_SIGNATURE_RECOVERY_CALLS_ENABLED=false

# Private production connection check (GET only); credentials never shared with sandbox.
SALES_CLICKSIGN_CONNECTION_ENABLED=false
SALES_CLICKSIGN_CONNECTION_CALLS_ENABLED=false
SALES_CLICKSIGN_PRODUCTION_TOKEN=

# Corpus oficial / novo RAG: entrega desligada, piloto restrito à Expert Energy.
EVA_CORPUS_PUBLICATION_ENABLED=false
EVA_CORPUS_PUBLICATION_CALLS_ENABLED=false
EVA_SEARCH_RAG_ENABLED=false
EVA_SEARCH_RAG_ORGANIZATIONS=

# Private long-document preparation; no Blob, Search or embedding calls.
EVA_DOCUMENT_PARTS_ENABLED=false

# Independent composite management, provider and retrieval gates.
EVA_COMPOSITE_PUBLICATION_ENABLED=false
EVA_COMPOSITE_CALLS_ENABLED=false
EVA_COMPOSITE_RAG_ENABLED=false

# Memória e recuperação compacta do fechamento; ativação separada
EVA_CLOSING_CONTEXT_ENABLED=false

# CCEE R1: private preparation only; activation and real reads require separate homologation.
CCEE_DATA_WORKSPACE_ENABLED=false
CCEE_PRIVATE_READ_ENABLED=false
CCEE_SYNC_WORKER_ENABLED=false
CCEE_OFFICIAL_CALENDAR_ENABLED=false

# Source-backed invoice/contract preparation V3. Technical delivery is OFF.
# Does not authorize OCR/AI, document debit, financial approval or publication.
EVA_SOURCE_PREPARATION_V3_ENABLED=false

# R2A: explicit phase activation; absent is disabled.
CCEE_DRI_READ_ENABLED=false
