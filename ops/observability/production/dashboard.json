{
  "uid": "energyos-eva",
  "title": "EnergyOS · EVA e estabilidade",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "energyos",
    "runtime"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Idade da amostra (sem dados não significa saudável)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "energyos-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - energyos_runtime_sample_timestamp_seconds",
          "legendFormat": "{{process_role}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sem dados",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Memória RSS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "energyos-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "energyos_runtime_rss_bytes",
          "legendFormat": "{{process_role}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Sem dados",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "CPU (100% = um núcleo)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "energyos-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "energyos_runtime_cpu_percent",
          "legendFormat": "{{process_role}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Sem dados",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Event loop p95 / p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "energyos-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "energyos_event_loop_p99_milliseconds",
          "legendFormat": "{{process_role}} {{stage}}"
        },
        {
          "refId": "B",
          "expr": "energyos_event_loop_p95_milliseconds",
          "legendFormat": "p95 {{process_role}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "Sem dados",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Tarefas ativas / limite",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "energyos-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "energyos_poller_active",
          "legendFormat": "{{process_role}} {{stage}}"
        },
        {
          "refId": "B",
          "expr": "energyos_poller_limit",
          "legendFormat": "limite {{process_role}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem dados",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Pollers em backoff",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "energyos-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "energyos_poller_backing_off",
          "legendFormat": "{{process_role}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem dados",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Etapas EVA p95 (estimado por buckets)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "energyos-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage, process_role) (rate(energyos_eva_stage_duration_seconds_bucket[5m])))",
          "legendFormat": "{{process_role}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sem dados",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Etapas EVA p99 (estimado por buckets)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "energyos-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, stage, process_role) (rate(energyos_eva_stage_duration_seconds_bucket[5m])))",
          "legendFormat": "{{process_role}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sem dados",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Falhas de etapas por segundo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "energyos-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage, process_role) (rate(energyos_eva_stage_failed_total[5m]))",
          "legendFormat": "{{process_role}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "Sem dados",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "timezone": "browser",
  "description": "Agregados técnicos. Ausência de dados não confirma disponibilidade; percentis por etapa são estimativas por buckets."
}
